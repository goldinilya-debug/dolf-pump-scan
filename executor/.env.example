# ===== BingX executor settings. Copy to .env (copy .env.example .env) and fill in. NEVER commit .env =====

# --- BingX API (key permissions: Read + Perpetual Futures trading; NO withdrawals; bind to your home IP if possible)
BINGX_API_KEY=
BINGX_API_SECRET=

# demo = VST paper money on https://open-api-vst.bingx.com ; live = real money on https://open-api.bingx.com
MODE=demo
# live trading starts only if this is exactly YES
CONFIRM_LIVE=NO

# --- Telegram (create a SEPARATE bot in @BotFather for the executor; TG_CHAT = your numeric chat id)
TG_TOKEN=
TG_CHAT=

# --- Risk (global)
RISK_PCT=1                 # default % risk per trade of a strategy's allocation (S06: allocation = balance/2)
MAX_LEVERAGE=3             # isolated leverage set on each symbol; notional is also capped at MAX_LEVERAGE x allocation
DAILY_LOSS_LIMIT_PCT=3     # equity down 3% since 00:00 UTC -> no new entries until next UTC day
TOTAL_DD_LIMIT_PCT=10      # equity down 10% from peak -> no new entries until /resume
MAX_OPEN_POSITIONS=4       # all strategies together
MAX_TOTAL_RISK_PCT=3       # sum of open risk (entry-to-stop x qty) as % of equity, all strategies together

# --- Strategies (1 = on). Only S06 is the tested primary.
STRAT_S06=1
STRAT_DONCHIAN=0           # reference B from paper_bot (ported, parity-tested, off)
STRAT_STAR=0               # 4h star reversal, 15 coins, TP 1R (ported, NOT parity-tested, off)
STRAT_PUMPS=0              # DOLF pump shorts — stub, cannot be enabled yet

# Per-strategy budget (optional; empty = defaults)
RISK_S06=1
#CAPITAL_S06=1             # share of balance S06 sizes from
#MAXPOS_S06=2
RISK_DONCHIAN=1
RISK_STAR=0.5
#STAR_LONG_ONLY=1
#SYMBOLS_STAR=BTC-USDT,ETH-USDT,SOL-USDT

# --- Engine
ACT_DELAY_MIN=5            # act this many minutes after a bar close (S06: 00:05 UTC)
STOP_WORKING_TYPE=CONTRACT_PRICE   # stop trigger price: CONTRACT_PRICE (last trade, like the backtest) or MARK_PRICE
EXIT_ON_FLIP_WHEN_HALTED=1 # while halted, still close a position when its strategy says exit (reduces risk)
#MARKET_DATA_BASE=https://open-api.bingx.com   # candles source (same as paper_bot); trading goes to MODE's host
